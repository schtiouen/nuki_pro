  "services": {
    "lock_action": {
      "name": "Lock action",
      "description": "Runs a Nuki lock action (Lock 'n' Go, full lock...).",
      "fields": {
        "action": {
          "name": "Action",
          "description": "Action to run."
        },
        "transport": {
          "name": "Channel",
          "description": "Force MQTT or Web API; automatic by default."
        }
      }
    },
    "create_keypad_code": {
      "name": "Create keypad code",
      "description": "Adds a keypad code, with optional time limits.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Shown in the log (32 characters max)."
        },
        "code": {
          "name": "Code",
          "description": "6 digits from 1 to 9, not starting with 12."
        },
        "allowed_from_date": {
          "name": "Valid from",
          "description": "First day and time the authorization works."
        },
        "allowed_until_date": {
          "name": "Valid until",
          "description": "Last day and time the authorization works."
        },
        "allowed_weekdays": {
          "name": "Allowed weekdays",
          "description": "Leave empty for every day."
        },
        "allowed_from_time": {
          "name": "Daily start time",
          "description": "Start of the daily time window."
        },
        "allowed_until_time": {
          "name": "Daily end time",
          "description": "End of the daily time window."
        }
      }
    },
    "update_authorization": {
      "name": "Update authorization",
      "description": "Renames, enables or disables, restricts, or changes the code of a user, fob or keypad code.",
      "fields": {
        "authorization": {
          "name": "Authorization",
          "description": "Name or id (see the Access switches attributes)."
        },
        "name": {
          "name": "New name",
          "description": "New name (32 characters max)."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Enable or disable the access."
        },
        "remote_allowed": {
          "name": "Remote access",
          "description": "Allow use from outside (app users)."
        },
        "code": {
          "name": "New code",
          "description": "6 digits from 1 to 9, not starting with 12."
        },
        "allowed_from_date": {
          "name": "Valid from",
          "description": "First day and time the authorization works."
        },
        "allowed_until_date": {
          "name": "Valid until",
          "description": "Last day and time the authorization works."
        },
        "allowed_weekdays": {
          "name": "Allowed weekdays",
          "description": "Leave empty for every day."
        },
        "allowed_from_time": {
          "name": "Daily start time",
          "description": "Start of the daily time window."
        },
        "allowed_until_time": {
          "name": "Daily end time",
          "description": "End of the daily time window."
        }
      }
    },
    "delete_authorization": {
      "name": "Delete authorization",
      "description": "Deletes a user, fob or keypad code.",
