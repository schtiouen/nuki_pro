{
  "device": {
    "door_sensor": {
      "name": "{lock} door sensor"
    },
    "keypad": {
      "name": "{lock} keypad"
    },
    "fob": {
      "name": "{lock} fob"
    }
  },
  "issues": {
    "mqtt_unavailable": {
      "title": "Nuki Pro: MQTT unavailable",
      "description": "{name} is set up to use MQTT, but the MQTT integration is not available. The lock keeps working through the Nuki Web API. Set up MQTT again, or turn MQTT off with Reconfigure."
    }
  },
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Nuki Web API token",
        "description": "Create an API token on {token_url} (menu API, generate token). Tick the permissions to view and manage the smart locks, operate them, manage authorizations and config, and view the activity log.",
        "data": {
          "api_token": "API token"
        },
        "data_description": {
          "api_token": "The token gives access to your Nuki account: keep it secret."
        }
      },
      "select_lock": {
        "title": "Choose the lock",
        "data": {
          "nuki_id": "Lock"
        }
      },
      "mqtt_setup": {
        "title": "Local MQTT (optional)",
        "description": "MQTT is optional and off by default: like hass_nuki_ng, everything then goes through the Web API, polled every 30 s. With MQTT, the state arrives instantly and lock actions stay on your network; enable MQTT in the Nuki app with your broker first. Lock found on the broker: {detected}",
        "data": {
          "use_mqtt": "Use MQTT",
          "mqtt_topic": "Lock topic"
        },
        "data_description": {
          "mqtt_topic": "Usually nuki/{nuki_id}."
        }
      },
      "reauth_confirm": {
        "title": "New Nuki Web API token",
        "description": "The token of {name} was rejected. Create a new one on {token_url}.",
        "data": {
          "api_token": "API token"
        }
      },
      "reconfigure": {
        "title": "Reconfigure {name}",
        "description": "Leave the token empty to keep the current one.",
        "data": {
          "api_token": "API token",
          "use_mqtt": "Use MQTT",
          "mqtt_topic": "Lock topic"
        }
      }
    },
    "error": {
      "invalid_auth": "Token rejected.",
      "missing_scope": "The token lacks a required permission.",
      "cannot_connect": "Cannot reach the Nuki Web API.",
      "unknown": "Unexpected error.",
      "no_devices": "No smart lock on this account.",
      "lock_not_in_account": "This lock is not on this Nuki account.",
      "mqtt_no_data": "Nothing received on this topic: check MQTT in the Nuki app, or untick MQTT.",
      "mqtt_not_configured": "The MQTT integration is not set up."
    },
    "abort": {
      "already_configured": "This lock is already configured.",
      "invalid_discovery_info": "Invalid MQTT discovery message.",
      "not_supported": "This Nuki device is not a smart lock.",
      "reauth_successful": "Token updated.",
      "reconfigure_successful": "Configuration updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Nuki Pro options",
        "data": {
          "scan_interval": "Web API polling interval",
          "action_transport": "Channel for lock actions",
          "auth_entities": "One switch per user or code"
        },
        "data_description": {
          "scan_interval": "Leave empty for automatic: 30 s, or 300 s while MQTT is online."
        }
      }
    }
  },
