        "title": "Scegli la serratura",
        "data": {
          "nuki_id": "Serratura"
        }
      },
      "mqtt_setup": {
        "title": "MQTT locale (facoltativo)",
        "description": "MQTT è facoltativo e disattivato per impostazione predefinita: in tal caso tutto passa dalla Web API, interrogata ogni 30 s. Con MQTT lo stato arriva all'istante e le azioni sulla serratura restano nella tua rete; prima abilita MQTT nell'app Nuki indicando il tuo broker. Serratura trovata sul broker: {detected}",
        "data": {
          "use_mqtt": "Usa MQTT",
          "mqtt_topic": "Argomento MQTT della serratura"
        },
        "data_description": {
          "mqtt_topic": "Di solito nuki/{nuki_id}."
        }
      },
