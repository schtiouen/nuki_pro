  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Token Nuki Web API",
        "description": "Crea un token API su {token_url} (menu API, genera token). Seleziona i permessi per visualizzare e gestire le Smart Lock, azionarle, gestire autorizzazioni e configurazione e visualizzare il registro attività.",
