        "title": "Nuovo token Nuki Web API",
        "description": "Il token di {name} è stato rifiutato. Creane uno nuovo su {token_url}.",
        "data": {
          "api_token": "Token API"
        }
      },
      "reconfigure": {
        "title": "Riconfigura {name}",
        "description": "Lascia vuoto il token per mantenere quello attuale.",
        "data": {
