    "mqtt_unavailable": {
      "title": "Nuki Pro: MQTT nicht verfügbar",
      "description": "{name} ist für MQTT eingerichtet, aber die MQTT-Integration ist nicht verfügbar. Das Schloss funktioniert weiterhin über die Nuki Web API. Richte MQTT erneut ein oder deaktiviere MQTT über „Neu konfigurieren“."
    }
  },
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Token für die Nuki Web API",
        "description": "Erstelle ein API-Token auf {token_url} (Menü „API“, Token generieren). Aktiviere die Zugriffsrechte, um die Smart Locks anzuzeigen, zu verwalten und zu bedienen, Berechtigungen und Konfiguration zu verwalten sowie das Aktivitätsprotokoll anzuzeigen.",
        "data": {
          "api_token": "API-Token"
        },
        "data_description": {
          "api_token": "Das Token gewährt Zugriff auf dein Nuki-Konto – halte es geheim."
        }
      },
      "select_lock": {
        "title": "Schloss auswählen",
        "data": {
          "nuki_id": "Schloss"
        }
      },
      "mqtt_setup": {
        "title": "Lokales MQTT (optional)",
        "description": "MQTT ist optional und standardmäßig deaktiviert: Dann läuft alles über die Web API, die alle 30 s abgefragt wird. Mit MQTT wird der Zustand sofort übermittelt und Schlossaktionen bleiben in deinem Netzwerk; richte dafür zuerst MQTT mit deinem Broker in der Nuki-App ein. Auf dem Broker gefundenes Schloss: {detected}",
        "data": {
          "use_mqtt": "MQTT verwenden",
          "mqtt_topic": "Topic des Schlosses"
        },
        "data_description": {
          "mqtt_topic": "Normalerweise nuki/{nuki_id}."
        }
      },
      "reauth_confirm": {
        "title": "Neues Token für die Nuki Web API",
        "description": "Das Token für {name} wurde abgelehnt. Erstelle ein neues auf {token_url}.",
        "data": {
          "api_token": "API-Token"
        }
      },
      "reconfigure": {
        "title": "{name} neu konfigurieren",
        "description": "Lass das Token leer, um das aktuelle zu behalten.",
        "data": {
          "api_token": "API-Token",
          "use_mqtt": "MQTT verwenden",
          "mqtt_topic": "Topic des Schlosses"
        }
      }
